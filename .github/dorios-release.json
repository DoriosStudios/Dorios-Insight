{
    "$schema":  "https://raw.githubusercontent.com/DoriosStudios/Dorios-Workflows/v1.0.2/releases/schemas/project.schema.json",
    "schemaVersion":  1,
    "project":  {
                    "name":  "Dorios\u0027 Insight",
                    "slug":  "insight"
                },
    "release":  {
                    "defaultChannel":  "stable",
                    "bedrockManifestPaths":  [
                                                 "BP/manifest.json",
                                                 "RP/manifest.json"
                                             ]
                },
    "build":  {
                  "enabled":  true,
                  "type":  "regolith",
                  "developmentProfile":  "buildDev",
                  "releaseProfile":  "buildMinify",
                  "outputDirectory":  "build",
                  "packDirectories":  [
                                          "Dorios\u0027 Insight BP",
                                          "Dorios\u0027 Insight RP"
                                      ]
              },
    "distribution":  {
                         "github":  true,
                         "curseforge":  {
                                            "enabled":  false
                                        }
                     },
    "links":  {

              },
    "announcement":  {
                         "enabled":  false
                     }
}
