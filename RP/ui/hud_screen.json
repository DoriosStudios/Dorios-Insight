{
    "namespace": "hud",

    "root_panel": {
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": {
                    "insight_waila_panel@insight_waila.root_panel": {}
                }
            },
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": {
                    "insight_hud_durability_panel@insight_hud_durability.root_panel": {}
                }
            },
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": {
                    "insight_player_status_panel@insight_player_status.root_panel": {}
                }
            },
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": {
                    "insight_resource_hud_panel@insight_resource_hud.root_panel": {}
                }
            },
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": {
                    "insight_statscore_activity_panel@insight_statscore_activity.root_panel": {}
                }
            },
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": {
                    "insight_custom_effects_panel@insight_custom_effects.root_panel": {}
                }
            },
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": {
                    "insight_actionbar_queue_panel@insight_actionbar_queue.root_panel": {}
                }
            }
        ]
    },

    "exp_progress_bar_and_hotbar": {
        "controls": [
            {
                "resource_hud@insight_resource_hud.classic_resource_modes": {}
            },
            {
                "item_text_factory": {
                    "size": [100, 10],
                    "type": "factory",
                    "control_ids": {
                        "item_text": "@hud.item_name_text",
                        "jukebox_text": "@hud.jukebox_popup_text"
                    }
                }
            }
        ]
    },

    "exp_progress_bar_and_hotbar_pocket": {
        "controls": [
            {
                "resource_hud@insight_resource_hud.pocket_resource_modes": {}
            }
        ]
    },

    // The selected-item HUD string contains the item name followed by its
    // enchantments. Limit its label to one line so only the name is shown.
    "item_name_text_root": {
        "type": "panel",
        "size": ["100%cm", "100%cm"],
        "$show_interact_padding|default": false,
        "$show_survival_padding|default": false,
        "$show_text_background|default": false,
        "$text_color|default": "$tool_tip_text",
        "$text_binding|default": "#item_text",
        "anchor_from": "bottom_middle",
        "anchor_to": "bottom_middle",
        "$wait_duration|default": 1,
        "$destroy_id|default": "item_name_text",
        "controls": [
            {
                "item_text_aligner": {
                    "type": "stack_panel",
                    "size": ["100%cm", "100%c"],
                    "controls": [
                        {
                            "item_text_control": {
                                "type": "panel",
                                "size": ["100%cm", "100%cm"],
                                "controls": [
                                    {
                                        "item_text_background": {
                                            "ignored": "(not $show_text_background)",
                                            "type": "image",
                                            "size": ["100%sm + 12px", "100%sm + 5px"],
                                            "texture": "textures/ui/hud_tip_text_background",
                                            "alpha": "@hud.anim_item_name_background_alpha_in"
                                        }
                                    },
                                    {
                                        "item_text_label": {
                                            "type": "label",
                                            "max_size": [200, 11],
                                            "text_alignment": "center",
                                            "layer": 31,
                                            "color": "$text_color",
                                            "text": "#text",
                                            "alpha": "@hud.anim_item_name_text_alpha_in",
                                            "shadow": true,
                                            "bindings": [
                                                {
                                                    "binding_name": "$text_binding",
                                                    "binding_name_override": "#text"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "interact_padding@common.empty_panel": {
                                "visible": "$show_interact_padding",
                                "size": ["100%sm", 18],
                                "bindings": [
                                    {
                                        "binding_name": "#interact_visible",
                                        "binding_name_override": "#visible",
                                        "binding_condition": "always"
                                    }
                                ]
                            }
                        },
                        {
                            "survival_buffer@common.empty_panel": {
                                "visible": "$show_survival_padding",
                                "size": ["100%sm", 17],
                                "bindings": [
                                    {
                                        "binding_name": "#show_survival_ui",
                                        "binding_name_override": "#visible"
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },

    "hud_title_text": {
        "$pb_namespace": "pb:",
        "$ds_namespace": "ds:",
        "$title_txt": "$title_text",
        "visible": "((($title_txt - $pb_namespace) = $title_txt) and (($title_txt - $ds_namespace) = $title_txt))",
        "type": "stack_panel",
        "orientation": "vertical",
        "offset": [0, -19],
        "layer": 1,
        "alpha": "@hud.anim_title_text_alpha_in",
        "propagate_alpha": true,
        "controls": [
            {
                "title_frame": {
                    "type": "panel",
                    "size": ["100%", "100%cm"],
                    "controls": [
                        {
                            "title": {
                                "type": "label",
                                "anchor_from": "top_middle",
                                "anchor_to": "top_middle",
                                "color": "$title_command_text_color",
                                "enable_profanity_filter": true,
                                "text": "#text",
                                "layer": 31,
                                "localize": false,
                                "font_size": "extra_large",
                                "shadow": true,
                                "text_alignment": "center",
                                "offset": [0, 6],
                                "bindings": [
                                    {
                                        "binding_name": "#hud_title_text_string",
                                        "binding_name_override": "#text",
                                        "binding_type": "global"
                                    },
                                    {
                                        "binding_type": "view",
                                        "source_property_name": "(((#text - $pb_namespace) = #text) and ((#text - $ds_namespace) = #text))",
                                        "target_property_name": "#visible"
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "subtitle_frame": {
                    "type": "panel",
                    "size": ["100%", "100%cm"],
                    "controls": [
                        {
                            "subtitle": {
                                "type": "label",
                                "anchor_from": "top_middle",
                                "anchor_to": "top_middle",
                                "color": "$title_command_text_color",
                                "enable_profanity_filter": true,
                                "text": "#text",
                                "layer": 31,
                                "localize": false,
                                "font_size": "large",
                                "shadow": true,
                                "text_alignment": "center",
                                "offset": [0, 6],
                                "bindings": [
                                    {
                                        "binding_name": "#hud_subtitle_text_string",
                                        "binding_name_override": "#text",
                                        "binding_type": "global"
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    }
}
