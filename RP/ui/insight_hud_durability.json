{
    "namespace": "insight_hud_durability",

    "root_panel": {
        "type": "panel",
        "size": ["100%", "100%"],
        "layer": 18,
        "controls": [
            { "section_e@insight_hud_durability.section_e": {} },
            { "section_f@insight_hud_durability.section_f": {} },
            { "section_i@insight_hud_durability.section_i": {} },
            { "durability_overlay@insight_hud_durability.durability_overlay": {} }
        ]
    },

    "section_e": {
        "type": "panel",
        "size": [0, 0],
        "bindings": [
            { "binding_name": "#hud_title_text_string" },
            {
                "binding_name": "#hud_title_text_string",
                "binding_name_override": "#stored_text",
                "binding_condition": "visibility_changed"
            },
            {
                "binding_type": "view",
                "source_property_name": "(('%.47s' * (#stored_text - ('%.38s' * #stored_text))) - 'e')",
                "target_property_name": "#data_e"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#data_e / 1000000)",
                "target_property_name": "#hud_health_indicator"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#data_e / 10000) - (#hud_health_indicator * 100)",
                "target_property_name": "#hud_hunger_indicator"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#data_e / 10) - (#hud_health_indicator * 100000) - (#hud_hunger_indicator * 1000)",
                "target_property_name": "#dur_percent"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#data_e / 1) - (#hud_health_indicator * 1000000) - (#hud_hunger_indicator * 10000) - (#dur_percent * 10)",
                "target_property_name": "#dur_visible"
            },
            {
                "binding_type": "view",
                "source_property_name": "(not (#hud_title_text_string = #stored_text) and not ((#hud_title_text_string - 'insight_hud') = #hud_title_text_string))",
                "target_property_name": "#visible"
            }
        ]
    },

    "section_f": {
        "type": "panel",
        "size": [0, 0],
        "bindings": [
            { "binding_name": "#hud_title_text_string" },
            {
                "binding_name": "#hud_title_text_string",
                "binding_name_override": "#stored_text",
                "binding_condition": "visibility_changed"
            },
            {
                "binding_type": "view",
                "source_property_name": "(('%.56s' * (#stored_text - ('%.47s' * #stored_text))) - 'f')",
                "target_property_name": "#data_f"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#data_f / 1000000)",
                "target_property_name": "#dur_cur_hi"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#data_f / 10000) - (#dur_cur_hi * 100)",
                "target_property_name": "#dur_cur_lo"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#data_f / 100) - (#dur_cur_hi * 10000) - (#dur_cur_lo * 100)",
                "target_property_name": "#dur_max_hi"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#data_f / 1) - (#dur_cur_hi * 1000000) - (#dur_cur_lo * 10000) - (#dur_max_hi * 100)",
                "target_property_name": "#dur_max_lo"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#dur_cur_hi * 100) + #dur_cur_lo",
                "target_property_name": "#dur_current"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#dur_max_hi * 100) + #dur_max_lo",
                "target_property_name": "#dur_max"
            },
            {
                "binding_type": "view",
                "source_property_name": "(not (#hud_title_text_string = #stored_text) and not ((#hud_title_text_string - 'insight_hud') = #hud_title_text_string))",
                "target_property_name": "#visible"
            }
        ]
    },

    "section_i": {
        "type": "panel",
        "size": [0, 0],
        "bindings": [
            { "binding_name": "#hud_title_text_string" },
            {
                "binding_name": "#hud_title_text_string",
                "binding_name_override": "#stored_text",
                "binding_condition": "visibility_changed"
            },
            {
                "binding_type": "view",
                "source_property_name": "(('%.83s' * (#stored_text - ('%.74s' * #stored_text))) - 'i')",
                "target_property_name": "#data_i"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#data_i / 1000000)",
                "target_property_name": "#dur_display_mode"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#data_i / 10000) - (#dur_display_mode * 100)",
                "target_property_name": "#dur_position"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#data_i / 100) - (#dur_display_mode * 10000) - (#dur_position * 100)",
                "target_property_name": "#dur_icon_visible"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#data_i / 1) - (#dur_display_mode * 1000000) - (#dur_position * 10000) - (#dur_icon_visible * 100)",
                "target_property_name": "#dur_reserved"
            },
            {
                "binding_type": "view",
                "source_property_name": "(not (#hud_title_text_string = #stored_text) and not ((#hud_title_text_string - 'insight_hud') = #hud_title_text_string))",
                "target_property_name": "#visible"
            }
        ]
    },

    "inventory_hud_item_icon@common.item_renderer": {
        "$item_collection_name": "$item_collection_name",
        "property_bag": {
            "force_update": true
        }
    },

    "durability_indicator_item": {
        "$item_collection_name|default": "hotbar_items",
        "type": "panel",
        "size": ["100%c", "100%c"],
        "controls": [
            {
                "content": {
                    "type": "stack_panel",
                    "orientation": "vertical",
                    "size": ["100%c", "100%cm"],
                    "controls": [
                        {
                            "top_row": {
                                "type": "stack_panel",
                                "orientation": "horizontal",
                                "offset": [0, 2],
                                "size": ["100%c", "100%cm"],
                                "controls": [
                                    {
                                        "icon_panel": {
                                            "type": "panel",
                                            "size": [16, 16],
                                            "controls": [
                                                {
                                                    "item_renderer@insight_hud_durability.inventory_hud_item_icon": {
                                                        "$item_collection_name": "$item_collection_name",
                                                        "size": [14, 14],
                                                        "layer": 1
                                                    }
                                                }
                                            ],
                                            "bindings": [
                                                {
                                                    "binding_type": "view",
                                                    "source_control_name": "section_i",
                                                    "source_property_name": "(#dur_icon_visible > 0)",
                                                    "target_property_name": "#visible",
                                                    "binding_condition": "always"
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "icon_gap": {
                                            "type": "panel",
                                            "size": [2, 1],
                                            "bindings": [
                                                {
                                                    "binding_type": "view",
                                                    "source_control_name": "section_i",
                                                    "source_property_name": "(#dur_icon_visible > 0)",
                                                    "target_property_name": "#visible",
                                                    "binding_condition": "always"
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "percent_text": {
                                            "type": "stack_panel",
                                            "orientation": "horizontal",
                                            "size": ["100%c", "100%cm"],
                                            "controls": [
                                                {
                                                    "value": {
                                                        "type": "label",
                                                        "text": "#text",
                                                        "shadow": true,
                                                        "font_scale_factor": 0.65,
                                                        "color": [0.55, 0.9, 0.55],
                                                        "bindings": [
                                                            {
                                                                "binding_type": "view",
                                                                "source_control_name": "section_e",
                                                                "source_property_name": "#dur_percent",
                                                                "target_property_name": "#dur_percent_value",
                                                                "binding_condition": "always"
                                                            },
                                                            {
                                                                "binding_type": "view",
                                                                "source_property_name": "('§z' + #dur_percent_value)",
                                                                "target_property_name": "#text",
                                                                "binding_condition": "always"
                                                            }
                                                        ]
                                                    }
                                                },
                                                {
                                                "symbol": {
                                                    "type": "label",
                                                    "text": "%%",
                                                    "shadow": true,
                                                    "font_scale_factor": 0.65,
                                                    "color": [0.65, 0.65, 0.65]
                                                }
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "values_row": {
                                "type": "stack_panel",
                                "orientation": "horizontal",
                                "size": ["100%c", "100%cm"],
                                "controls": [
                                    {
                                        "current": {
                                            "type": "label",
                                            "text": "#text",
                                            "shadow": true,
                                            "font_scale_factor": 0.65,
                                            "color": [0.92, 0.92, 0.92],
                                            "bindings": [
                                                {
                                                    "binding_type": "view",
                                                    "source_control_name": "section_f",
                                                    "source_property_name": "#dur_current",
                                                    "target_property_name": "#dur_current_value",
                                                    "binding_condition": "always"
                                                },
                                                {
                                                    "binding_type": "view",
                                                    "source_property_name": "('§z' + #dur_current_value)",
                                                    "target_property_name": "#text",
                                                    "binding_condition": "always"
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "slash": {
                                            "type": "label",
                                            "text": "/",
                                            "shadow": true,
                                            "font_scale_factor": 0.65,
                                            "color": [0.55, 0.55, 0.55]
                                        }
                                    },
                                    {
                                        "max": {
                                            "type": "label",
                                            "text": "#text",
                                            "shadow": true,
                                            "font_scale_factor": 0.65,
                                            "color": [0.92, 0.92, 0.92],
                                            "bindings": [
                                                {
                                                    "binding_type": "view",
                                                    "source_control_name": "section_f",
                                                    "source_property_name": "#dur_max",
                                                    "target_property_name": "#dur_max_value",
                                                    "binding_condition": "always"
                                                },
                                                {
                                                    "binding_type": "view",
                                                    "source_property_name": "('§z' + #dur_max_value)",
                                                    "target_property_name": "#text",
                                                    "binding_condition": "always"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ],
        "bindings": [
            {
                "binding_name": "#slot_selected",
                "binding_type": "collection",
                "binding_collection_name": "$item_collection_name"
            },
            {
                "binding_name": "#item_durability_total_amount",
                "binding_type": "collection",
                "binding_collection_name": "$item_collection_name"
            },
            {
                "binding_type": "view",
                "source_property_name": "(not (#item_durability_total_amount = 0))",
                "target_property_name": "#has_native_durability",
                "binding_condition": "always"
            },
            {
                "binding_type": "view",
                "source_control_name": "section_e",
                "source_property_name": "(#dur_visible > 0)",
                "target_property_name": "#script_visible",
                "binding_condition": "always"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#slot_selected and #has_native_durability and #script_visible)",
                "target_property_name": "#visible",
                "binding_condition": "always"
            }
        ]
    },

    "durability_indicator": {
        "type": "collection_panel",
        "size": ["100%cm", "100%cm"],
        "collection_name": "hotbar_items",
        "factory": {
            "name": "durability_indicator_factory",
            "control_name": "insight_hud_durability.durability_indicator_item"
        },
        "property_bag": {
            "#hotbar_size": 9
        },
        "bindings": [
            {
                "binding_name": "#show_survival_ui",
                "binding_condition": "always"
            },
            {
                "binding_type": "view",
                "source_property_name": "#hotbar_size",
                "target_property_name": "#collection_length",
                "binding_condition": "always"
            },
            {
                "binding_type": "view",
                "source_control_name": "section_e",
                "source_property_name": "(#dur_visible > 0)",
                "target_property_name": "#has_durability",
                "binding_condition": "always"
            },
            {
                "binding_type": "view",
                "source_property_name": "(#show_survival_ui and #has_durability)",
                "target_property_name": "#visible",
                "binding_condition": "always"
            }
        ]
    },

    "durability_position_right_hotbar": {
        "type": "panel",
        "anchor_from": "bottom_middle",
        "anchor_to": "bottom_middle",
        "offset": [136, "-3.25%"],
        "layer": 28,
        "size": ["100%cm", "100%cm"],
        "controls": [
            { "content@insight_hud_durability.durability_indicator": {} }
        ],
        "bindings": [
            {
                "binding_type": "view",
                "source_control_name": "section_i",
                "source_property_name": "(#dur_position = 0)",
                "target_property_name": "#visible",
                "binding_condition": "always"
            }
        ]
    },

    "durability_overlay": {
        "type": "panel",
        "size": ["100%", "100%"],
        "controls": [
            { "right_hotbar@insight_hud_durability.durability_position_right_hotbar": {} }
        ]
    }
}
