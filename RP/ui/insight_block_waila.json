{
    "namespace": "insight_block_waila",

    "root_panel": {
        "$update_string": "insight_block_waila:",
        "type": "panel",
        "size": ["100%", "100%"],
        "controls": [
            {
                "data_control_block_waila": {
                    "type": "panel",
                    "size": [0, 0],
                    "property_bag": {
                        "#preserved_waila_text": "",
                        "#stored_subtitle_text": ""
                    },
                    "bindings": [
                        {
                            "binding_name": "#hud_title_text_string"
                        },
                        {
                            "binding_name": "#hud_title_text_string",
                            "binding_name_override": "#preserved_waila_text"
                        },
                        {
                            "binding_name": "#hud_subtitle_text_string",
                            "binding_name_override": "#stored_subtitle_text"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(not ((#hud_title_text_string - 'insight_block_waila:') = #hud_title_text_string) and not ((#stored_subtitle_text - 'block:') = #stored_subtitle_text))",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            },
            {
                "block_stored_render_aux": {
                    "type": "panel",
                    "size": [0, 0],
                    "property_bag": {
                        "#stored_entity_id": ""
                    },
                    "bindings": [
                        {
                            "binding_name": "#hud_subtitle_text_string",
                            "binding_name_override": "#stored_entity_id"
                        },
                        {
                            "binding_type": "view",
                            "source_control_name": "data_control_block_waila",
                            "source_property_name": "(not ((#preserved_waila_text - 'insight_block_waila:') = #preserved_waila_text) and not ((#stored_subtitle_text - 'block:') = #stored_subtitle_text))",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            },
            {
                "block_display_background": {
                    "type": "image",
                    "texture": "textures/insight/style_default",
                    "alpha": 0.85,
                    "property_bag": {
                        "#current_title_text": "",
                        "#current_subtitle_text": ""
                    },
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [0, "2.5%"],
                    "size": ["100%c + 20px", "100%cm + 10px"],
                    "nineslice_size": 4,
                    "controls": [
                        {
                            "block_display_stack": {
                                "type": "stack_panel",
                                "orientation": "horizontal",
                                "anchor_from": "center",
                                "anchor_to": "center",
                                "size": ["100%c", "100%cm"],
                                "layer": 5,
                                "controls": [
                                    {
                                        "block_display_panel": {
                                            "type": "panel",
                                            "size": [32, "100%sm"],
                                            "max_size": ["100%y", "100%sm"],
                                            "controls": [
                                                {
                                                    "block_display": {
                                                        "type": "custom",
                                                        "renderer": "inventory_item_renderer",
                                                        "size": ["100% - 4px", "100%x"],
                                                        "anchor_from": "center",
                                                        "anchor_to": "center",
                                                        "property_bag": {
                                                            "#item_id_aux": 0
                                                        },
                                                        "bindings": [
                                                            {
                                                                "binding_type": "view",
                                                                "source_control_name": "block_stored_render_aux",
                                                                "source_property_name": "((#stored_entity_id - 'block:') * 1)",
                                                                "target_property_name": "#item_id_aux"
                                                            }
                                                        ]
                                                    }
                                                }
                                            ],
                                            "bindings": [
                                                {
                                                    "binding_type": "view",
                                                    "source_control_name": "block_stored_render_aux",
                                                    "source_property_name": "(not ((#stored_entity_id - 'block:') = #stored_entity_id) and not ((#stored_entity_id - 'block:') = '0'))",
                                                    "target_property_name": "#visible"
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "block_text_gap": {
                                            "type": "panel",
                                            "size": [4, 0],
                                            "bindings": [
                                                {
                                                    "binding_type": "view",
                                                    "source_control_name": "block_stored_render_aux",
                                                    "source_property_name": "(not ((#stored_entity_id - 'block:') = #stored_entity_id) and not ((#stored_entity_id - 'block:') = '0'))",
                                                    "target_property_name": "#visible"
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "text_display": {
                                            "type": "label",
                                            "text": "#waila_text",
                                            "shadow": true,
                                            "size": ["default", "default"],
                                            "max_size": [260, "default"],
                                            "bindings": [
                                                {
                                                    "binding_type": "view",
                                                    "source_control_name": "block_display_background",
                                                    "source_property_name": "#waila_text",
                                                    "target_property_name": "#waila_text"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        }
                    ],
                    "bindings": [
                        {
                            "binding_name": "#hud_title_text_string",
                            "binding_name_override": "#current_title_text"
                        },
                        {
                            "binding_name": "#hud_subtitle_text_string",
                            "binding_name_override": "#current_subtitle_text"
                        },
                        {
                            "binding_type": "view",
                            "source_control_name": "data_control_block_waila",
                            "source_property_name": "(#preserved_waila_text - 'insight_block_waila:')",
                            "target_property_name": "#waila_payload"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "((%.40s * #waila_payload) - '~')",
                            "target_property_name": "#panel_texture"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(#waila_payload - (%.40s * #waila_payload))",
                            "target_property_name": "#waila_text"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "#panel_texture",
                            "target_property_name": "#texture"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(not ((#current_title_text - 'insight_block_waila:') = #current_title_text) and not ((#current_subtitle_text - 'block:') = #current_subtitle_text))",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            }
        ]
    }
}
